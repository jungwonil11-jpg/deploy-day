{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deploy-day",
  "version": "0.1.0",
  "identifier": "com.victor.deployday",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "deploy-day",
        "width": 880,
        "height": 940,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#0C0C0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
